# Copy to .env and adjust. Every value below has a working default, so the
# project runs with no .env file at all.

# --- server -----------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# Origin allowed to call the API with credentials during `npm run dev`.
# GOLDBEAN_DEV_ORIGIN=http://localhost:5173

# --- storage ----------------------------------------------------------------
# SQLite file. Delete it (or run `npm run reset`) to start from scratch.
# GOLDBEAN_DB=./data/goldbean.db

# Signing key for session JWTs. Generated and stored in data/jwt.secret if unset.
# Set this explicitly in any real deployment so sessions survive a rebuild.
# GOLDBEAN_JWT_SECRET=change-me

# --- simulation tuning ------------------------------------------------------
# How often the live feed engine ticks (ms). Lower = faster demo.
# GOLDBEAN_TICK_MS=2000
# Cooldown between free bean drops (ms). Default 3 minutes.
# GOLDBEAN_DROP_COOLDOWN_MS=180000

# --- debugging --------------------------------------------------------------
# GOLDBEAN_DEBUG=1